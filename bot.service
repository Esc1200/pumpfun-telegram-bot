[Unit]
Description=Pump.fun Telegram Trading Bot
After=network.target

[Service]
Type=simple
User=administrator
WorkingDirectory=/home/administrator/pumpfun-telegram-bot
ExecStart=/home/administrator/pumpfun-telegram-bot/venv/bin/python3 /home/administrator/pumpfun-telegram-bot/main.py
Restart=always
RestartSec=5
StandardOutput=append:/home/administrator/pumpfun-telegram-bot/logs/bot.log
StandardError=append:/home/administrator/pumpfun-telegram-bot/logs/bot_error.log
Environment=PYTHONUNBUFFERED=1

# Hardening
ProtectSystem=false
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
